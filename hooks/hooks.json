{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/unread-result-hook.mjs\"",
            "statusMessage": "Checking for completed process jobs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/unread-result-hook.mjs\"",
            "statusMessage": "Checking for completed process jobs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/unread-result-hook.mjs\"",
            "statusMessage": "Checking for completed process jobs"
          }
        ]
      }
    ]
  }
}
